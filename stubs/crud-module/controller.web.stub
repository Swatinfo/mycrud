    /**
     * Remove the specified resource from storage (Soft Delete).
     *
     * @param  \{{namespace}}\Models\{{modelName}}  ${{modelNameSingularLowerCase}}
     * @return \Illuminate\Http\RedirectResponse
     */
    public function destroy(\{{namespace}}\Models\{{modelName}} ${{modelNameSingularLowerCase}})
    {
        // Gate::authorize('delete', ${{modelNameSingularLowerCase}});
        try {
            {{serviceCallDelete}}; // This should call the service's soft delete method
            return redirect()->route($this->routeNamePrefix . '.index')
                             ->with('success', '{{modelName}} (soft) deleted successfully.');
        } catch (\Illuminate\Database\Eloquent\ModelNotFoundException $e) {
            Log::warning("{{modelName}} not found for delete: id {${{modelNameSingularLowerCase}}->id}}", ['exception' => $e]);
            return redirect()->route($this->routeNamePrefix . '.index')->with('error', '{{modelName}} not found.');
        } catch (\Exception $e) {
            Log::error("Error deleting {{modelName}}: id {${{modelNameSingularLowerCase}}->id}} " . $e->getMessage(), ['exception' => $e]);
            return back()->with('error', 'Failed to delete {{modelName}}. Please try again.');
        }
    }

    /**
     * Display a listing of soft-deleted resources.
     *
     * @param \Illuminate\Http\Request $request
     * @return \Illuminate\Contracts\View\View|\Illuminate\Http\JsonResponse
     */
    public function trashed(Request $request)
    {
        // Gate::authorize('viewAny', \{{namespace}}\Models\{{modelName}}::class); // Or a specific 'view trashed' permission

        if ($request->ajax()) {
            try {
                $dataTableParams = [
                    'draw' => $request->input('draw'),
                    'start' => $request->input('start', 0),
                    'length' => $request->input('length', 10),
                    'search' => $request->input('search.value', ''),
                    'order' => $request->input('order', [['column' => 0, 'dir' => 'desc']]),
                    'columns' => $request->input('columns', []),
                    'trashed_filter' => 'only', // Force to only show trashed items
                ];

                $results = {{serviceCallGetDataForDataTable}}; ;

                return response()->json([
                    'draw' => intval($dataTableParams['draw']),
                    'recordsTotal' => $results['total'] ?? 0, // This might need adjustment in service to count only trashed
                    'recordsFiltered' => $results['filtered'] ?? 0,
                    'data' => $results['data'] ?? [],
                ]);
            } catch (\Exception $e) {
                Log::error("Error fetching trashed {{modelNamePluralLowerCase}} for DataTables: " . $e->getMessage(), ['exception' => $e]);
                return response()->json(['error' => 'Could not retrieve trashed data.'], 500);
            }
        }
        return view($this->viewPathPrefix . '.trashed', ['isTrashed' => true]); // Pass a flag to the view
    }

    /**
     * Restore the specified soft-deleted resource.
     *
     * @param  string $id  // Use string for ID to handle UUIDs if any, findOrFail will handle it
     * @return \Illuminate\Http\RedirectResponse
     */
    public function restore(string $id)
    {
        // Find the model instance first to authorize against it
        // The service method should handle finding only trashed models.
        // ${{modelNameSingularLowerCase}} = $this->{{modelNameSingularLowerCase}}Service->getById($id, [], true); // true for withTrashed
        // Gate::authorize('restore', ${{modelNameSingularLowerCase}});
        try {
            $restored = {{serviceCallRestore}};
            if ($restored) {
                return redirect()->route($this->routeNamePrefix . '.index')
                                 ->with('success', '{{modelName}} restored successfully.');
            }
            return back()->with('error', '{{modelName}} could not be restored or was not found in trash.');
        } catch (\Illuminate\Database\Eloquent\ModelNotFoundException $e) {
            return back()->with('error', '{{modelName}} not found in trash.');
        } catch (\Exception $e) {
            Log::error("Error restoring {{modelName}} with ID {$id}: " . $e->getMessage(), ['exception' => $e]);
            return back()->with('error', 'Failed to restore {{modelName}}. Please try again.');
        }
    }

    /**
     * Permanently delete the specified resource.
     *
     * @param  string $id
     * @return \Illuminate\Http\RedirectResponse
     */
    public function forceDelete(string $id)
    {
        // ${{modelNameSingularLowerCase}} = $this->{{modelNameSingularLowerCase}}Service->getById($id, [], true); // true for withTrashed
        // Gate::authorize('forceDelete', ${{modelNameSingularLowerCase}});
        try {
            $deleted = {{serviceCallForceDelete}};
            if ($deleted) {
                return redirect()->route($this->routeNamePrefix . '.trashed') // Or index, depending on preference
                                 ->with('success', '{{modelName}} permanently deleted successfully.');
            }
            return back()->with('error', '{{modelName}} could not be permanently deleted or was not found.');
        } catch (\Illuminate\Database\Eloquent\ModelNotFoundException $e) {
            return back()->with('error', '{{modelName}} not found.');
        } catch (\Exception $e) {
            Log::error("Error force deleting {{modelName}} with ID {$id}: " . $e->getMessage(), ['exception' => $e]);
            return back()->with('error', 'Failed to permanently delete {{modelName}}. Please try again.');
        }
    }
