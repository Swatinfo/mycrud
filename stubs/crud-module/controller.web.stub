            // Ensure the service method throws ModelNotFoundException if not found.

            // Eager load relationships if not already loaded and needed for the view
            // ${{modelNameSingularLowerCase}}->loadMissing(['user', 'comments']); // Example

            return view($this->viewPathPrefix . '.show', compact('{{modelNameSingularLowerCase}}'));
        } catch (\Illuminate\Database\Eloquent\ModelNotFoundException $e) {
            Log::warning("{{modelName}} not found for show: id {${{modelNameSingularLowerCase}}->id}}", ['exception' => $e]);
            return redirect()->route($this->routeNamePrefix . '.index')->with('error', '{{modelName}} not found.');
        } catch (\Exception $e) {
            Log::error("Error showing {{modelName}}: id {${{modelNameSingularLowerCase}}->id}} " . $e->getMessage(), ['exception' => $e]);
            return back()->with('error', 'Could not display {{modelName}}. Please try again later.');
        }
    }

