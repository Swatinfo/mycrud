    public function restore(string $id): JsonResponse
    {
        try {
            $this->{{modelNameSingularLowerCase}}Service->restore($id);
            ${{modelNameSingularLowerCase}} = $this->{{modelNameSingularLowerCase}}Service->getById($id); // Get the restored model
            return (new {{modelName}}Resource(${{modelNameSingularLowerCase}}))->response();
        } catch (ModelNotFoundException $e) {
