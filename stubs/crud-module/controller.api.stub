    /**
     * @OA\Delete(
     * path="/api/{{apiRoutePrefix}}/{id}", operationId="delete{{modelName}}", tags={"{{modelNamePlural}}"}, summary="Delete {{modelNameSingularLowerCase}} (Soft Delete)",
     * security={{"sanctum":{}}},
