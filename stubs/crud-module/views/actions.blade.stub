{{--
    This stub defines the HTML for action buttons.
    It expects a variable, typically named `$item` (passed from the controller for non-JS views)
    or constructed in JavaScript for DataTables (where `row` object is used).

    For DataTables, the `index.blade.stub` now handles this logic directly in JavaScript
    for dynamic row data. This stub is more for reference or for server-rendered lists
    where `$item` would be a PHP variable.

    Placeholders like `{{routeNamePrefix}}` and `{{modelNameSingularLowerCase}}`
    are replaced by the Artisan command.
--}}

{{-- View Action --}}
@can('view', ${{itemVar}} ?? null) {{-- Check if itemVar is set, for safety --}}
    <a href="{{ "{{ route('{{routeNamePrefix}}.show', $" . itemVar . "->id ?? ':id_placeholder') }}" }}" class="btn btn-sm btn-info me-1" title="View">
        <i class="fas fa-eye"></i>
    </a>
@endcan

{{-- Conditional Actions based on soft delete status --}}
@if(isset(${{itemVar}}->deleted_at) && ${{itemVar}}->deleted_at)
    {{-- Item is soft deleted --}}
    @can('restore', ${{itemVar}} ?? null)
        <form action="{{ "{{ route('{{routeNamePrefix}}.restore', $" . itemVar . "->id ?? ':id_placeholder') }}" }}" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to restore this {{modelNameSingularLowerCase}}?');">
            @csrf
            <button type="submit" class="btn btn-sm btn-success me-1" title="Restore">
                <i class="fas fa-undo"></i>
            </button>
        </form>
    @endcan
    @can('forceDelete', ${{itemVar}} ?? null)
        <form action="{{ "{{ route('{{routeNamePrefix}}.forceDelete', $" . itemVar . "->id ?? ':id_placeholder') }}" }}" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to permanently delete this {{modelNameSingularLowerCase}}? This action cannot be undone.');">
            @csrf
            @method('DELETE')
            <button type="submit" class="btn btn-sm btn-danger" title="Force Delete">
                <i class="fas fa-trash-alt" style="color: darkred;"></i>
            </button>
        </form>
    @endcan
@else
    {{-- Item is not soft deleted --}}
    @can('update', ${{itemVar}} ?? null)
        <a href="{{ "{{ route('{{routeNamePrefix}}.edit', $" . itemVar . "->id ?? ':id_placeholder') }}" }}" class="btn btn-sm btn-warning me-1" title="Edit">
            <i class="fas fa-edit"></i>
        </a>
    @endcan
    @can('delete', ${{itemVar}} ?? null)
        <form action="{{ "{{ route('{{routeNamePrefix}}.destroy', $" . itemVar . "->id ?? ':id_placeholder') }}" }}" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete (soft) this {{modelNameSingularLowerCase}}?');">
            @csrf
            @method('DELETE')
            <button type="submit" class="btn btn-sm btn-danger" title="Delete (Soft)">
                <i class="fas fa-trash"></i>
            </button>
        </form>
    @endcan
@endif
