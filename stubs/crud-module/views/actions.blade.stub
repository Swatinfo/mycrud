{{--
    This stub defines the content of the "Actions" column in DataTables.
    It expects a variable, typically named `$item` or `row` (in JS context),
    representing the current model instance for the row.
    The main command will replace {{itemVar}} with the correct variable name from JS.
--}}

@can('view', ${{itemVar}})
    <a href="{{ route('{{routeNamePrefix}}.show', ${{itemVar}}->id) }}" class="btn btn-sm btn-info me-1" title="View">
        <i class="fas fa-eye"></i>
    </a>
@endcan

@if(isset(${{itemVar}}->deleted_at) && ${{itemVar}}->deleted_at) {{-- Item is soft deleted --}}
    @can('restore', ${{itemVar}})
        <form action="{{ route('{{routeNamePrefix}}.restore', ${{itemVar}}->id) }}" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to restore this {{modelNameSingularLowerCase}}?');">
            @csrf
            <button type="submit" class="btn btn-sm btn-success me-1" title="Restore">
                <i class="fas fa-undo"></i>
            </button>
        </form>
    @endcan
    @can('forceDelete', ${{itemVar}})
        <form action="{{ route('{{routeNamePrefix}}.forceDelete', ${{itemVar}}->id) }}" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to permanently delete this {{modelNameSingularLowerCase}}? This action cannot be undone.');">
            @csrf
            @method('DELETE')
            <button type="submit" class="btn btn-sm btn-danger" title="Force Delete">
                <i class="fas fa-trash-alt" style="color: darkred;"></i> <small>Permanently</small>
            </button>
        </form>
    @endcan
@else {{-- Item is not soft deleted --}}
    @can('update', ${{itemVar}})
        <a href="{{ route('{{routeNamePrefix}}.edit', ${{itemVar}}->id) }}" class="btn btn-sm btn-warning me-1" title="Edit">
            <i class="fas fa-edit"></i>
        </a>
    @endcan
    @can('delete', ${{itemVar}})
        <form action="{{ route('{{routeNamePrefix}}.destroy', ${{itemVar}}->id) }}" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete (soft) this {{modelNameSingularLowerCase}}?');">
            @csrf
            @method('DELETE')
            <button type="submit" class="btn btn-sm btn-danger" title="Delete (Soft)">
                <i class="fas fa-trash"></i>
            </button>
        </form>
    @endcan
@endif
